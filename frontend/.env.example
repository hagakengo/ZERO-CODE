# Server-only configuration. Never put credentials in NEXT_PUBLIC_* variables.
ZERO_CODE_ADMIN_USER=operator
ZERO_CODE_ADMIN_PASSWORD=<long-random-secret>
ZERO_CODE_BACKEND_URL=http://127.0.0.1:8000
ZERO_CODE_WRITE_TOKEN=<matching-backend-write-token>
# Exact public origin, no trailing slash; HTTPS required outside loopback.
ZERO_CODE_FRONTEND_ORIGIN=http://localhost:3000
